{
  "name": "@lunarbase-lab/pmm-math",
  "version": "0.4.0",
  "description": "N-API binding for LunarBase linear quotes and immediate directional punishment, bit-exact with Solidity.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "wrapper.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./wrapper.js",
      "require": "./index.cjs",
      "types": "./index.d.ts"
    }
  },
  "files": [
    "wrapper.js",
    "index.cjs",
    "index.d.ts",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lunarbase-Lab/lunarbase-pmm-math.git",
    "directory": "math/rust-node/lunarbase-pmm-math-node"
  },
  "homepage": "https://github.com/Lunarbase-Lab/lunarbase-pmm-math#readme",
  "bugs": {
    "url": "https://github.com/Lunarbase-Lab/lunarbase-pmm-math/issues"
  },
  "keywords": [
    "lunarbase",
    "pmm",
    "amm",
    "defi",
    "napi",
    "rust"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "napi": {
    "name": "lunarbase-pmm-math",
    "triples": {
      "defaults": false,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl"
      ]
    }
  },
  "optionalDependencies": {
    "@lunarbase-lab/pmm-math-darwin-arm64": "0.4.0",
    "@lunarbase-lab/pmm-math-linux-x64-gnu": "0.4.0",
    "@lunarbase-lab/pmm-math-linux-arm64-gnu": "0.4.0",
    "@lunarbase-lab/pmm-math-linux-x64-musl": "0.4.0"
  },
  "scripts": {
    "build": "CARGO_TARGET_DIR=target napi build --platform --release --js index.cjs --no-const-enum && npm run verify:metadata",
    "build:debug": "CARGO_TARGET_DIR=target napi build --platform --js index.cjs --no-const-enum && npm run verify:metadata",
    "artifacts": "napi artifacts",
    "prepare:platform-packages": "node scripts/prepare-platform-packages.mjs",
    "verify:metadata": "node scripts/verify-generated-metadata.mjs",
    "test": "npm run test:types && node --test test/quote.test.mjs",
    "test:types": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run prepare:platform-packages && napi prepublish -t npm --skip-gh-release"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
