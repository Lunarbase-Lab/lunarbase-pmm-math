# Pool to mirror. The default is the Base ETH/USDC pool used in integration
# checks, but production deployments should inject this per market.
POOL_ADDRESS=0x0000eFC4ec03a7c47D3a38A9Be7Ff1d52dD01b99

# HTTP RPC is used only for startup seeding. Keep private/internal endpoints in
# your local .env; do not commit them.
RPC_URL=

# Use a flashblocks-aware WebSocket endpoint when low latency matters. A
# standard newHeads/logs endpoint can work, but it will quote at confirmed-block
# latency instead of pre-confirmation latency.
FLASH_WS=

REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_SECS=5

# Critical: this must be the exact address that directly calls the Pool in
# production. For routers/proxies/settlement contracts, use that contract, not
# the taker EOA and not SwapExecuted.recipient. If omitted, the example uses
# address(0), matching bare eth_call/cast-call defaults rather than executable
# partner flow.
QUOTE_CALLER_ADDRESS=0x0000000000000000000000000000000000000000

# Demo quote printed by src/main.rs. Your production quote handler should call
# quoter::quote_exact_in with request-specific amount/direction.
QUOTE_AMOUNT_IN=1000000000000000
QUOTE_DIRECTION=x_to_y
QUOTE_INTERVAL_SECS=5

# Fail fast if the startup HTTP RPC seed stalls. After seed completes, quote
# requests do not need RPC.
SEED_TIMEOUT_SECS=20

RUST_LOG=info,offchain_quoting_example_rust=debug
